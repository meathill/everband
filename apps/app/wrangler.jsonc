{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everband-app",
  "account_id": "fdc63eeea83ae8f5234357308b9a638b",
  "routes": [{ "pattern": "everband-app.meathill.com", "custom_domain": true }],
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": false
  },
  "vars": {
    // 生产真实发送；本地 dev 由 .dev.vars 覆盖为 dev（落 /dev/outbox）
    "EMAIL_MODE": "cloudflare",
    "EMAIL_FROM_ADDRESS": "no-reply@meathill.com",
    "EMAIL_FROM_NAME": "Everband",
    // mock | dyqr；dyqr 且 DYQR_TOKEN（Secret）存在时用真实短链，否则回退 mock
    "DYQR_MODE": "dyqr"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "everband",
      // 生产 database_id 部署前用 wrangler d1 create 生成后替换
      "database_id": "e1759245-2dfc-4bc4-93e5-976215432740",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      // 私有 bucket：导入原文件与附件；key 含组织与对象上下文（PRD §8.2）
      "bucket_name": "everband-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "IMPORT_QUEUE",
        "queue": "everband-import-jobs"
      },
      {
        "binding": "EMAIL_QUEUE",
        "queue": "everband-email-sends"
      }
    ]
  }
}
